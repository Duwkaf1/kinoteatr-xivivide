{
  "name": "yoru-anime",
  "productName": "Yoru",
  "version": "0.9.0",
  "private": true,
  "author": "Duwkaf1",
  "description": "Windows-плеер для кино, сериалов и аниме",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.js",
    "package:win": "npm run build && node scripts/package-win.js",
    "predev": "node scripts/copy-media-assets.js",
    "prebuild": "node scripts/copy-media-assets.js",
    "installer:win": "npm run package:win && node scripts/build-installer.js",
    "test:installer": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/test-installer.ps1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "hls.js": "1.7.3",
    "libass-wasm": "4.1.0",
    "video.js": "8.23.4",
    "vite": "8.3.5"
  }
}
